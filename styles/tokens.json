{
  "$schema": "https://tr.designtokens.org/format/",
  "metadata": {
    "prd_version": "UI-COLOR-SPEC-v2.0",
    "policy_version": "ASTRA-GPT6-1.0",
    "schema_version": "DTCG-2026.1",
    "plan_version": "PLAN-COLOR-60-30-10-v1.0",
    "wcag_standard": "W3C WCAG 2.2 AA/AAA",
    "geometry_constraint": "border-radius: 0px, box-shadow: none"
  },
  "primitives": {
    "color": {
      "option1": {
        "paper-do-bg": { "$type": "color", "$value": "#F6F0E4", "$description": "60% Nen giay do (Background Option 1)" },
        "brick-red-brand": { "$type": "color", "$value": "#8F2929", "$description": "30% Do gach (Primary Brand Option 1)" },
        "bronze-gold-accent": { "$type": "color", "$value": "#C29A50", "$description": "10% Vang dong (Accent Option 1)" },
        "charcoal-dark-text": { "$type": "color", "$value": "#292723", "$description": "Neutral Dark (Text Option 1 - 13.13:1 AAA)" },
        "paper-do-secondary": { "$type": "color", "$value": "#E5DCCB", "$description": "Neutral Light (Card/Border Option 1)" }
      },
      "option2": {
        "grey-beige-bg": { "$type": "color", "$value": "#F1F0E5", "$description": "60% Be xam (Background Option 2)" },
        "olive-green-brand": { "$type": "color", "$value": "#566447", "$description": "30% Xanh olive (Primary Brand Option 2)" },
        "antique-gold-accent": { "$type": "color", "$value": "#B9A16A", "$description": "10% Vang co (Accent Option 2)" },
        "green-charcoal-text": { "$type": "color", "$value": "#292E27", "$description": "Neutral Dark (Text Option 2 - 12.11:1 AAA)" },
        "sage-light-secondary": { "$type": "color", "$value": "#DADCCF", "$description": "Neutral Light (Card/Border Option 2)" }
      },
      "option3": {
        "blue-white-bg": { "$type": "color", "$value": "#F3F7FA", "$description": "60% Trang xanh (Background Option 3)" },
        "peace-blue-brand": { "$type": "color", "$value": "#356B91", "$description": "30% Xanh hoa binh (Primary Brand Option 3)" },
        "star-gold-accent": { "$type": "color", "$value": "#D7AD45", "$description": "10% Vang sao (Accent Option 3)" },
        "vermilion-sub-accent": { "$type": "color", "$value": "#B9574B", "$description": "Sub-Accent Do son diu (Option 3 - 4.64:1 AA on white)" },
        "slate-navy-text": { "$type": "color", "$value": "#263541", "$description": "Neutral Dark (Text Option 3 - 11.69:1 AAA)" },
        "ice-blue-secondary": { "$type": "color", "$value": "#DCE6ED", "$description": "Neutral Light (Card/Border Option 3)" }
      },
      "common": {
        "pure-white": { "$type": "color", "$value": "#FFFFFF", "$description": "Inverse white text on brand" }
      }
    },
    "radius": {
      "none": { "$type": "dimension", "$value": "0px" }
    },
    "shadow": {
      "none": { "$type": "shadow", "$value": "none" }
    }
  },
  "semantic": {
    "surface": {
      "bg": {
        "primary": {
          "$type": "color",
          "$value": {
            "option1": "#F6F0E4",
            "option2": "#F1F0E5",
            "option3": "#F3F7FA"
          },
          "$description": "Nen trang tong the (60%)"
        }
      },
      "card": {
        "secondary": {
          "$type": "color",
          "$value": {
            "option1": "#E5DCCB",
            "option2": "#DADCCF",
            "option3": "#DCE6ED"
          },
          "$description": "Vien card, duong phan cach, nen phu"
        }
      }
    },
    "brand": {
      "primary": {
        "default": {
          "$type": "color",
          "$value": {
            "option1": "#8F2929",
            "option2": "#566447",
            "option3": "#356B91"
          },
          "$description": "Header, dieu huong, nut CTA chinh (30%)"
        }
      },
      "accent": {
        "highlight": {
          "$type": "color",
          "$value": {
            "option1": "#C29A50",
            "option2": "#B9A16A",
            "option3": "#D7AD45"
          },
          "$description": "Huy hieu, moc thoi gian, so lieu (10%)"
        },
        "secondary": {
          "$type": "color",
          "$value": {
            "option1": "#8F2929",
            "option2": "#566447",
            "option3": "#B9574B"
          },
          "$description": "Nhan su kien dac biet, diem nhan phu"
        }
      }
    },
    "text": {
      "primary": {
        "body": {
          "$type": "color",
          "$value": {
            "option1": "#292723",
            "option2": "#292E27",
            "option3": "#263541"
          },
          "$description": "Tieu de lon, noi dung bai viet, ho so"
        }
      },
      "on-brand": {
        "inverse": {
          "$type": "color",
          "$value": {
            "option1": "#F6F0E4",
            "option2": "#FFFFFF",
            "option3": "#FFFFFF"
          },
          "$description": "Chu tren nut CTA va thanh Header"
        }
      }
    }
  }
}
